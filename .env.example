# Core
FAST2SMS_API_KEY=your-api-key-here
FAST2SMS_DEFAULT_SENDER_ID=FSTSMS
FAST2SMS_DEFAULT_ROUTE=dlt
FAST2SMS_DRIVER=api # "api" for real HTTP calls, "log" for local dev (no credits used)

# Database logging — set to true and publish migrations to log every send
FAST2SMS_DATABASE_LOGGING=false

# Balance alert threshold
FAST2SMS_BALANCE_THRESHOLD=1000

# Queue
FAST2SMS_QUEUE_ENABLED=false
FAST2SMS_QUEUE_CONNECTION=
FAST2SMS_QUEUE_NAME=default
FAST2SMS_QUEUE_TRIES=3

# Events
FAST2SMS_EVENTS_ENABLED=true

# Deduplication (idempotency guard)
FAST2SMS_DEDUP_ENABLED=false
FAST2SMS_DEDUP_TTL=60
FAST2SMS_DEDUP_STORE=

# Recipients
FAST2SMS_STRIP_INVALID=false
FAST2SMS_DEDUP_RECIPIENTS=true
FAST2SMS_BATCH_SIZE=0

# Balance gate — abort sends when balance is below threshold
FAST2SMS_BALANCE_GATE=false
FAST2SMS_BALANCE_ABORT=true

# Rate throttle
FAST2SMS_THROTTLE_ENABLED=false
FAST2SMS_THROTTLE_MAX=60
FAST2SMS_THROTTLE_STORE=

# WhatsApp (Meta Cloud API)
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_WABA_ID=
FAST2SMS_WHATSAPP_VERSION=v24.0
